#!/bin/bash
#SBATCH --job-name=4b_mo_pi
#SBATCH --account=plantto
#SBATCH --partition=small
#SBATCH --time=03-00:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=15G
#SBATCH --output=nmr-ml_matten-output_%j.txt
#SBATCH --error=nmr-ml_matten-errors_%j.txt

source /scratch/plantto/olaurila/matten/matten_install/mat_venv/bin/activate
#module load pytorch/2.5

# Set unlimited stack size
ulimit -s unlimited

split -l 7300 -a 4 -d PREFIX.pos_1.xyz seg
for i in {0000..0249}; do
     python3 predict_atomic_tensor.py seg"$i" output_prediction"$i".csv --save_every 1 --model_path "../" --checkpoint "model.ckpt"
     awk -v i="$i" 'NR>1 {print i$0}' output_prediction"$i".csv >> predictions.csv
     #rm -f seg"$i" output_prediction"$i".csv
     rm -f seg"$i"
done
