<simulation mode='static' verbosity='medium'>
  <output prefix='PREFIX'>
    <checkpoint filename='chk' stride='10000'></checkpoint>
    <properties stride='20' filename='out'>  [ step, potential{electronVolt}, temperature{kelvin} ] </properties>-->
    <trajectory stride='20' filename='pos'>  positions{angstrom}  </trajectory>
    <trajectory stride='200' filename='for'>  forces  </trajectory>
  </output>
  <ffsocket mode='inet' name='driver' pbc='False'>
    <address>localhost</address>
    <port>26110</port>
  </ffsocket>
  <total_steps> 10000 </total_steps>
  <system>
     <initialize nbeads='1'>
       <file mode='xyz'>  init.xyz </file>
       <velocities mode='thermal' units='kelvin'> 300 </velocities>
     </initialize>
     <forces>
        <force forcefield='driver'> </force>
     </forces>
     <ensemble>
       <temperature units='kelvin'> 300 </temperature>
     </ensemble>
     <motion mode='dynamics'>
       <dynamics mode='nvt'>
        <thermostat mode='pile_g'>
          <tau units='femtosecond'> 50 </tau>
        </thermostat>
         <timestep units='femtosecond'> 0.5 </timestep>
       </dynamics>
     </motion>
   </system>
</simulation>
